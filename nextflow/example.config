// Example Nextflow config for VARUS v2.
//
// Copy and edit for your cluster / local setup, then run:
//   nextflow run nextflow/main.nf -c nextflow/example.config --species_csv mycsv.csv

process {
    // Local: comment out the next line; SLURM: uncomment it.
    // executor = 'slurm'
    // queue    = 'short'
    cpus     = 4
    memory   = '8 GB'
    time     = '24h'

    withName: VARUS_RUNLIST {
        cpus          = 1
        memory        = '2 GB'
        time          = '1h'
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withName: VARUS_INDEX {
        cpus   = 8
        memory = '32 GB'
        time   = '4h'
    }
    withName: VARUS_RUN {
        cpus          = 16
        memory        = '24 GB'
        time          = '72h'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

executor {
    queueSize = 50
}

params {
    outdir              = 'results'
    varus_max_batches   = 1000
    varus_batch_size    = 50000
    // ncbi_email       = 'you@host'   // recommended for Entrez politeness
    // ncbi_api_key     = '...'        // raises rate limit to 10 req/s
}
